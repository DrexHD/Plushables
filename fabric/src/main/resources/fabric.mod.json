{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "icon": "assets/${mod_id}/icon.png",
  "authors": [
    "${mod_author}"
  ],
  "contributors": [
    "BumbleSculpts", "Luke", "ChrysanthCow", "Steam 'n' Rails Team", "Sammy", "hibi", "Joosh", "Omasumi", "wiiv"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${license}",
  "accessWidener": "${mod_id}.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.khazoda.plushables.PlushablesFabric"
    ],
    "client": [
      "com.khazoda.plushables.platform.PlushablesFabricClient"
    ],
    "fabric-datagen": [
      "com.khazoda.plushables.datagen.PlushablesDataGenerator"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json", "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "khazodacore": ">=${khazodacore_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.com/invite/vEZUkSxwR9"
      }
    },
    "catalogue": {
      "banner": "assets/${mod_id}/banner.png",
      "background": "assets/${mod_id}/background.png"
    }
  }
}
